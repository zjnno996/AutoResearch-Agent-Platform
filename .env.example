# Copy to ~/.config/emnets-ra/provider.env, fill in your own values, then chmod 600.
# This file contains public examples only; never commit the private copy.
EMNETS_PROVIDER_LOCK=1
EMNETS_API_BASE=http://localhost:8000/v1
EMNETS_MODEL=Qwen3.8-27B-FP8
EMNETS_API_KEY_ENV=RESEARCHCLAW_API_KEY
RESEARCHCLAW_API_KEY=
EMNETS_UNLIMITED_TOKENS=1
EMNETS_QUALITY_FIRST=1
# Optional executable overrides; otherwise setup-web.sh uses .venv-web.
# PYTHON_PATH=/absolute/path/to/python
# EMNETS_SANDBOX_PYTHON=/absolute/path/to/experiment/python
# EMNETS_NODE_BIN=/absolute/path/to/node/bin
